{
  "database_path": "data/dashboard.db",
  "repository_roots": [],
  "excluded_dirs": [
    ".git",
    ".hg",
    ".svn",
    "node_modules",
    ".venv",
    "venv",
    "env",
    "__pycache__",
    ".tox",
    ".nox",
    ".mypy_cache",
    ".ruff_cache",
    ".pytest_cache",
    "site-packages",
    "dist",
    "build",
    "target",
    "out",
    ".next",
    ".nuxt",
    ".cache",
    ".idea",
    ".vscode",
    "Library",
    "AppData",
    "$RECYCLE.BIN",
    "System Volume Information"
  ],
  "max_scan_depth": 6,
  "history_depth": 500,
  "file_changes_per_commit_limit": 100,
  "git_binary": "git",
  "git_timeout_seconds": 30,
  "stale_branch_days": 90,
  "inactive_branch_days": 30,
  "repo_inactive_days": 30,
  "repo_stale_days": 90,
  "repo_abandoned_days": 180,
  "refresh_interval_minutes": 0,
  "log_level": "INFO",
  "host": "127.0.0.1",
  "port": 8000
}
